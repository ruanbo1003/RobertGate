[Unit]
Description=RobertGate API (FastAPI + uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/RobertGate/backend
Environment="PATH=/home/ubuntu/RobertGate/backend/.venv/bin"
ExecStart=/home/ubuntu/RobertGate/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3
# StandardOutput/StandardError 默认走 journald，用 `journalctl -u robertgate-api -f` 查看

[Install]
WantedBy=multi-user.target
